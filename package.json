{
  "name": "room-314",
  "version": "1.0.0",
  "description": "POS & Inventory Management System for Room-314 Kirana Store",
  "private": true,
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "build": "cd client && npm install && npm run build",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && node app.js",
    "client": "cd client && npm run dev",
    "migrate": "cd server && node migrations/run.js",
    "seed": "cd server && node seeds/demo.js",
    "backup": "node backups/backup.js",
    "test": "node server/test/test-runner.js",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.6.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0"
  }
}

