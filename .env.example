# Room-314 Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# JWT Secret - CHANGE THIS to a random string
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars

# Gemini API Key (for Blinkit screenshot extraction)
# Get your free key at https://aistudio.google.com
GEMINI_API_KEY=

# Database path (relative to server/)
DB_PATH=../database/room314.db

# Upload directory (relative to server/)
UPLOAD_DIR=../uploads

# Shop defaults
SHOP_NAME=Room-314
SHOP_PHONE=
SHOP_ADDRESS=

